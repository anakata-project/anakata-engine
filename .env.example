# Must match the running API origin. CORS allows this engine via FRONTEND_ENGINE_URL
# (http://localhost:3000 locally). On Netlify, set NUXT_PUBLIC_API_BASE in the site env.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Empty = analytics off. A GA4 measurement id (G-…) shows the consent banner.
# Banner wording and a cookie policy are LEG-002 (pending client).
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Empty = Marker.io widget off. Set the project id to show the feedback button.
NUXT_PUBLIC_MARKER_PROJECT_ID=
